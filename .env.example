# Copy to .env.local for local development. Never commit real secrets.

# --- Public (inlined into the browser bundle at BUILD time) ---
# Canonical site URL, used for metadata, sitemap and structured data.
# In Docker, pass it as a build arg: --build-arg NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (read at runtime, never exposed to the browser) ---
# Set to "true" on staging/preview deployments to serve `Disallow: /` in robots.txt.
# DISALLOW_INDEXING=false
